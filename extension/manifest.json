{
  "manifest_version": 3,
  "name": "Malicious URL Detector",
  "version": "1.1.0",
  "description": "Detects malicious URLs using a local ML model with LIME explanations.",

  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "notifications",
    "webNavigation",
    "declarativeNetRequest"
  ],

  "host_permissions": [
    "http://localhost:5000/*",
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "history.html"],
      "matches"  : ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "icons/icon.png"
  }
}